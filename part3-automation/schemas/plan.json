{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.json",
  "type": "object",
  "required": [
    "id",
    "name",
    "coverage",
    "category",
    "currency",
    "monthlyPrice"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "coverage": {
      "type": "string"
    },
    "category": {
      "enum": [
        "standard",
        "discounted"
      ]
    },
    "currency": {
      "const": "EUR"
    },
    "monthlyPrice": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
