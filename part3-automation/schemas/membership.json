{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "membership.json",
  "type": "object",
  "required": [
    "membershipId",
    "memberId",
    "plan",
    "currency",
    "monthlyPrice",
    "status"
  ],
  "properties": {
    "membershipId": {
      "type": "string"
    },
    "memberId": {
      "type": "string"
    },
    "plan": {
      "type": "string"
    },
    "currency": {
      "const": "EUR"
    },
    "monthlyPrice": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "status": {
      "type": "string"
    }
  }
}
